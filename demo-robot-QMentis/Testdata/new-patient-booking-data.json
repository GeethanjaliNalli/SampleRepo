      "booking_date": "2025-12-01",
      "booking_time": "10:30",
      "diary": "Dr. Smith",
      "expected_result": "No booking created; error message displayed for missing required fields."
    },
    {
      "test_name": "TC_NPB_BoundaryTimeSlot",
